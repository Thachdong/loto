        <mxCell id="c2" value="SCR-01 · Mở trong Zalo/Messenger — hướng dẫn mở trình duyệt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="375" height="24" as="geometry"/></mxCell>
        <mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=12;align=center;verticalAlign=middle;fontColor=#333333;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="375" height="812" as="geometry"/></mxCell>
        <mxCell id="c4" value="LÔ TÔ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;align=center;verticalAlign=middle;fontColor=#333333;spacingLeft=6;spacingRight=6;dashed=1;fontStyle=1;arcSize=20;" vertex="1" parent="1"><mxGeometry x="147.5" y="120" width="80" height="80" as="geometry"/></mxCell>
        <mxCell id="c5" value="Mở bằng trình duyệt để đăng nhập" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=18;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="16" y="216" width="343" height="32" as="geometry"/></mxCell>
        <mxCell id="c6" value="Ứng dụng này (Zalo/Messenger…) không cho đăng nhập Google.&lt;br&gt;&lt;br&gt;1. Bấm nút ⋯ ở góc trên bên phải&lt;br&gt;2. Chọn &quot;Mở bằng trình duyệt&quot;&lt;br&gt;   hoặc copy link rồi dán vào Chrome/Safari" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;fontColor=#333333;spacingLeft=6;spacingRight=6;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="16" y="260" width="343" height="150" as="geometry"/></mxCell>
