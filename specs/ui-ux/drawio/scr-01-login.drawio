  <diagram id="scr-01-b" name="Trình duyệt trong ứng dụng chat">
    <mxGraphModel dx="1280" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="435" pageHeight="872" math="0" shadow="0">
