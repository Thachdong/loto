# Copy thành .env.local rồi điền giá trị. Giá trị dưới đây dành cho Firebase Emulator (project demo-loto),
# không phải bí mật. Khi dùng project thật: thay NEXT_PUBLIC_FIREBASE_* bằng config web app trong Firebase console
# và bỏ các dòng *_EMULATOR_HOST.

# ── Client (Firebase JS SDK) ──
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-loto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-loto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-loto.appspot.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-loto
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_USE_EMULATOR=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server (firebase-admin, seed) ──
GCLOUD_PROJECT=demo-loto
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
